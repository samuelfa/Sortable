{
	"name": "sortablejs",
	"exportName": "Sortable",
	"version": "1.15.7",
	"type": "module",
	"description": "JavaScript library for reorderable drag-and-drop lists on modern browsers and touch devices. No jQuery required. Supports Meteor, AngularJS, React, Polymer, Vue, Knockout and any CSS library, e.g. Bootstrap.",
	"main": "./Sortable.min.js",
	"module": "modular/sortable.esm.js",
	"scripts": {
		"build:umd": "cross-env NODE_ENV=umd rollup -c ./scripts/umd-build.js",
		"build:umd:watch": "cross-env NODE_ENV=umd rollup -w -c ./scripts/umd-build.js",
		"build:es": "cross-env NODE_ENV=es rollup -c ./scripts/esm-build.js",
		"build:es:watch": "cross-env NODE_ENV=es rollup -w -c ./scripts/esm-build.js",
		"minify": "node ./scripts/minify.js",
		"build": "npm run build:es && npm run build:umd && npm run minify",
		"build:coverage": "cross-env BABEL_ENV=test COVERAGE=true npm run build:umd && cross-env BABEL_ENV=test COVERAGE=true npm run build:es && npm run minify",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format:check": "prettier --check \"**/*.{js,json,md,yml,yaml}\"",
		"format:write": "prettier --write \"**/*.{js,json,md,yml,yaml}\"",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:debug": "playwright test --debug",
		"test:coverage": "BABEL_ENV=test COVERAGE=true npx playwright test --project=chromium --project=firefox --project=webkit",
		"coverage": "npm run build:coverage && npm run test:coverage && npx nyc report --reporter=text --reporter=html --reporter=lcov",
		"coverage:ci": "npm run coverage"
	},
	"devDependencies": {
		"@babel/core": "^7.26.9",
		"@babel/plugin-transform-object-assign": "^7.29.7",
		"@babel/preset-env": "^7.26.9",
		"@playwright/test": "^1.62.1",
		"@rollup/plugin-babel": "^6.0.4",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"babel-plugin-istanbul": "^7.0.1",
		"cross-env": "^10.1.0",
		"eslint": "^10.9.1",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"knip": "^6.32.3",
		"nyc": "^17.1.0",
		"prettier": "^3.9.6",
		"rollup": "^4.63.0",
		"serve": "^14.2.6",
		"uglify-js": "^3.19.3"
	},
	"nyc": {
		"all": true,
		"include": [
			"src/**/*.js",
			"plugins/**/*.js"
		],
		"exclude": [
			"tests/**",
			"entry/**",
			"scripts/**",
			"node_modules/**"
		],
		"reporter": [
			"text",
			"html",
			"lcov"
		],
		"report-dir": "./coverage",
		"instrument": false,
		"thresholds": {
			"statements": 80,
			"branches": 80,
			"functions": 80,
			"lines": 80
		}
	},
	"maintainers": [
		"Konstantin Lebedev <ibnRubaXa@gmail.com>",
		"Owen Mills <owen23355@gmail.com>",
		"Samuel Fernández <samuel84fa@gmail.com>"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SortableJS/Sortable.git"
	},
	"files": [
		"Sortable.js",
		"Sortable.min.js",
		"modular/",
		"src/"
	],
	"keywords": [
		"sortable",
		"reorder",
		"drag",
		"meteor",
		"angular",
		"ng-sortable",
		"react",
		"vue",
		"mixin"
	],
	"license": "MIT"
}
